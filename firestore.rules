rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return signedIn() && exists(userDocPath());
    }

    function myUserDoc() {
      return get(userDocPath());
    }

    function myRole() {
      return userExists() ? myUserDoc().data.role : null;
    }

    function isPlatformOwner() {
      return signedIn() && myRole() == 'platformOwner';
    }

    function isAdmin() {
      return signedIn() && myRole() in ['admin', 'lead', 'platformOwner'];
    }

    // Scoped to the authenticated user's centrally assigned branch.
    // Accounts without a configured branch cannot access branch data.
    function canAccessBranch(branchCode) {
      return isPlatformOwner()
        || (userExists()
          && myUserDoc().data.get('branch', '') == branchCode);
    }

    function isWorker() {
      return signedIn() && myRole() in ['worker', 'picker', 'counter'];
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validUserCreate(userId) {
      return isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['worker', 'picker', 'counter']
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'name',
          'role',
          'department',
          'status',
          'createdAt',
          'updatedAt'
        ]);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if validUserCreate(userId) || isAdmin();

      allow update: if isAdmin();

      allow delete: if isPlatformOwner();
    }

    match /employees/{employeeId} {
      allow read: if signedIn();

      allow create, update: if isAdmin();

      allow delete: if isPlatformOwner();
    }

    match /itemMaster/{itemId} {
      allow read: if signedIn();

      allow create, update: if isAdmin();

      allow delete: if isPlatformOwner();
    }

    match /receivingLabels/{labelId} {
      allow read: if signedIn();

      allow create: if signedIn();

      allow update, delete: if isAdmin();
    }

    match /locations/{locationId} {
      allow read: if signedIn();

      allow create, update: if isAdmin();

      allow delete: if isPlatformOwner();
    }

    match /qrScans/{scanId} {
      allow read: if signedIn();

      allow create: if signedIn();

      allow update, delete: if isAdmin();
    }

    match /scanVerifications/{scanId} {
      allow read: if signedIn();

      allow create: if signedIn();

      allow update, delete: if isAdmin();
    }

    match /pullConfirmations/{pullId} {
      allow read: if signedIn();

      allow create: if signedIn();

      allow update, delete: if isAdmin();
    }

    match /putAwayLogs/{logId} {
      allow read: if signedIn();

      allow create: if signedIn();

      allow update, delete: if isAdmin();
    }

    match /cycleCountSessions/{sessionId} {
      allow read: if signedIn();

      allow create: if signedIn();

      allow update, delete: if isAdmin();
    }

    match /orderPickingSessions/{sessionId} {
      allow read: if signedIn();

      allow create: if signedIn();

      allow update, delete: if isAdmin();
    }

    match /activityLogs/{activityId} {
      allow read: if signedIn();

      allow create: if signedIn();

      allow update, delete: if isAdmin();
    }

    // Shared production uploads: supervisor-owned, immutable imports.
    // Deploy these rules before enabling production publishing.
    match /productionImports/{importId} {
      allow read: if isAdmin() && canAccessBranch(resource.data.branch);
      allow create: if isAdmin()
        && canAccessBranch(request.resource.data.branch)
        && request.resource.data.importedBy == request.auth.uid
        && request.resource.data.branch is string
        && request.resource.data.periodStart is string
        && request.resource.data.periodEnd is string
        && request.resource.data.rows is list
        && request.resource.data.rows.size() <= 500
        && request.resource.data.keys().hasOnly([
          'branch', 'periodStart', 'periodEnd', 'workdays',
          'filename', 'importedAt', 'importedBy', 'rows'
        ]);
      allow update, delete: if false;
    }

    match /settings/{settingId} {
      allow read: if signedIn();

      allow create, update: if isAdmin();

      allow delete: if isPlatformOwner();
    }

    match /history/{historyId} {
      allow read: if signedIn();

      allow create: if signedIn();

      allow update, delete: if isAdmin();
    }

    match /appLogs/{logId} {
      allow read: if isAdmin();

      allow create: if signedIn();

      allow update, delete: if isPlatformOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
